# Copy to .env if you want to override local defaults. Do not put real secrets here.
# Docker Compose maps PostgreSQL to localhost:5433.

LEDGERLAB_DB_URL=jdbc:postgresql://localhost:5433/ledgerlab
LEDGERLAB_DB_USER=ledgerlab
LEDGERLAB_DB_PASSWORD=ledgerlab

# Required outside the dev/e2e/test profiles. Must be at least 32 characters.
LEDGERLAB_JWT_SECRET=replace-me-with-a-32-plus-character-secret

LEDGERLAB_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
PORT=8080
